#r "../../library/bin/Release/net8.0/Library.dll"

open System.IO
open Cube
open Lse
open Render
open System.Collections.Generic

let policyPath = Path.GetFullPath(Path.Combine(__SOURCE_DIRECTORY__, "..", "Data", "lse-policy-v1.dat"))
let policy = loadPolicy policyPath

let candidates =
    [ "user-a", "E2 M' E2 M'"
      "user-b", "E2 M' E2 M"
      "existing-a", "E2 M E2 M"
      "existing-b", "E2 M E2 M'" ]

for name, text in candidates do
    let moves = stringToSteps text |> List.choose (function Move move -> Some move | _ -> None)
    let setup = moves |> List.rev |> List.map inverseMove
    let state = Cube.solved |> executeMoves setup
    let solved = state |> executeMoves moves
    let index = indexCube state
    let distance = distance policy index |> Option.get
    let table = solveIndex policy index
    let bestKnown = solveCubeRelativeBestKnown policy Cube.solved state
    if solved <> Cube.solved then failwith $"{name} does not solve its inverse setup."
    if bestKnown.Length <> 4 then failwith $"{name} was not selected as a four-move shortcut."
    if state |> executeMoves bestKnown <> Cube.solved then failwith $"{name} shortcut did not solve the cube."
    printfn "%s | %s | M/U distance %d | best known %s | table %s" name text distance (movesToString bestKnown) (movesToString table)

let centerKey cube =
    [ Center.U; Center.D; Center.L; Center.R; Center.F; Center.B ]
    |> List.map (fun center ->
        let face, sticker = centerToFaceSticker center
        look face sticker cube)
    |> List.toArray

let centers = Queue<Cube>()
let seenCenters = HashSet<Color array>(HashIdentity.Structural)
centers.Enqueue Cube.solved
seenCenters.Add(centerKey Cube.solved) |> ignore
while centers.Count > 0 do
    let cube = centers.Dequeue()
    for move in [ Move.M; Move.E2 ] do
        let next = executeMove cube move
        if seenCenters.Add(centerKey next) then centers.Enqueue next
printfn "center orbit generated by M and E2: %d" seenCenters.Count
